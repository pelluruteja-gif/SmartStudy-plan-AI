# SmartStudy AI — Environment Variables Example
# Duplicate this file to .env for local configuration or define variables in Render Dashboard

# Web server port (Render injects PORT automatically)
PORT=8000
HOST=0.0.0.0

# Optional: Google Gemini API Key for AI Study Coach & Multi-Day Plan Generation
# If omitted or empty, SmartStudy AI automatically uses its robust local heuristic engine.
GEMINI_API_KEY=

# Optional: Comma-separated list of allowed CORS origins
# Render automatically provides RENDER_EXTERNAL_URL. Add any custom domains here.
ALLOWED_ORIGINS=
